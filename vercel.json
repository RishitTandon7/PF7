{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/os", "destination": "/os/", "permanent": false },
    { "source": "/3d", "destination": "/os/3d/", "permanent": false },
    { "source": "/3d/playbook", "destination": "/os/3d/playbook/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(certificates|media|tex)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/(.*)\\.pdf",
      "headers": [{ "key": "Content-Disposition", "value": "inline" }]
    }
  ]
}
