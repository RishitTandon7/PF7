{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/os", "destination": "/os/", "permanent": false },
    { "source": "/3d", "destination": "/os/3d/", "permanent": false },
    { "source": "/3d/playbook", "destination": "/os/3d/playbook/", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/projects", "destination": "/#projects", "permanent": true },
    { "source": "/project/:slug", "destination": "/projects/:slug", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(certificates|media|tex|og)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/(favicon.svg|favicon.ico|favicon-32.png|apple-touch-icon.png|icon-192.png|icon-512.png|site.webmanifest|seo.css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(sitemap.xml|robots.txt|llms.txt|llms-full.txt|humans.txt)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/(.*)\\.pdf", "headers": [{ "key": "Content-Disposition", "value": "inline" }] }
  ]
}
